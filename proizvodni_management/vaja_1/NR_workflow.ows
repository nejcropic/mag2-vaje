		<properties node_id="2" format="literal">{'auto_commit': True, 'color_by_class': True, 'controlAreaVisible': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01\xa6\x00\x00\x00\xd2\x00\x00\x04\xc7\x00\x00\x02\xe4\x00\x00\x01\xa7\x00\x00\x00\xf0\x00\x00\x04\xc6\x00\x00\x02\xe3\x00\x00\x00\x00\x00\x00\x00\x00\x06n\x00\x00\x01\xa7\x00\x00\x00\xf0\x00\x00\x04\xc6\x00\x00\x02\xe3', 'select_rows': True, 'show_attribute_labels': True, 'show_distributions': False, 'stored_selection': {'rows': [3], 'columns': [0, 1, 2]}, 'stored_sort': [], '__version__': 1}</properties>
		<properties node_id="3" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x02\xc9\x00\x00\x00\x93\x00\x00\x062\x00\x00\x03z\x00\x00\x02\xca\x00\x00\x00\xb1\x00\x00\x061\x00\x00\x03y\x00\x00\x00\x00\x00\x00\x00\x00\x06n\x00\x00\x02\xca\x00\x00\x00\xb1\x00\x00\x061\x00\x00\x03y', 'scriptLibrary': [{'name': 'Table from numpy', 'script': "import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndef moving_average(x,nn):\n    x_len=len(x)\n    y = np.zeros(x_len)\n    for idx in range(x_len):\n        if idx&lt;nn:\n            y[idx]=np.nan\n        else:\n            y[idx]=np.sum(x[(idx-nn):idx])/nn\n    return y\n\nin_data = in_data\n\nt=in_data[:,'Datum'].X.flatten()\nx=in_data[:,'Povpraševanje'].X.flatten()\n\ny_new = moving_average(x,2)\n\ndomain = Domain([ContinuousVariable('Datum'),ContinuousVariable('Povpraševanje'),ContinuousVariable('Moving_Avearage')])\n\narr=np.column_stack((t,x,y_new))\n\nout_data = Table.from_numpy(domain,arr)", 'filename': None}], 'scriptText': "import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndef moving_average(x,nn):\n    x_len=len(x)\n    y = np.zeros(x_len)\n    for idx in range(x_len):\n        if idx&lt;nn:\n            y[idx]=np.nan\n        else:\n            y[idx]=np.sum(x[(idx-nn):idx])/nn\n    return y\n\nin_data = in_data\n\nt=in_data[:,'Datum'].X.flatten()\nx=in_data[:,'Povpraševanje'].X.flatten()\n\ny_new = moving_average(x,2)\n\ndomain = Domain([ContinuousVariable('Datum'),ContinuousVariable('Povpraševanje'),ContinuousVariable('Moving_Avearage')])\n\narr=np.column_stack((t,x,y_new))\n\nout_data = Table.from_numpy(domain,arr)", 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
